    "@nestjs/websockets": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@types/cors": "^2.8.19",
    "@types/node": "22.19.0",
    "@types/ws": "^8.18.1",
    "typescript": "6.0.3"
  },
